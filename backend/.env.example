# Trello: Integrante 4 — configuración local de la API; no subir el archivo .env real.
# Para una primera demostración local usamos SQLite y no hace falta instalar MySQL.
DATABASE_URL=sqlite:///./comotos.db

# Solo para desarrollo local. En equipo, cada integrante debe usar un valor propio en su .env.
JWT_SECRET=cambia-este-valor-por-una-clave-aleatoria-larga
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cuando MySQL esté configurado, reemplaza DATABASE_URL por: 
# DATABASE_URL=mysql+pymysql://root:TU_PASSWORD@127.0.0.1:3306/comotos
